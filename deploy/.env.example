# Domínio apontando (registro A) para o IP da VPS
NEXO_DOMAIN=nexo.suaempresa.com.br
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=
# Código para criar contas sem convite (fundadores). Gere com: openssl rand -base64 18
SIGNUP_CODE=
SESSION_DAYS=30
# Entrar com Google (opcional): ID do cliente OAuth "Aplicativo da Web" e e-mails que podem criar conta sem convite
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_EMAILS=
